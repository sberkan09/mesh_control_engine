{
  "format": "mce-scene",
  "version": 1,
  "guid": "@GUID_SCENE@",
  "name": "main",
  "entities": [
    {
      "name": "Camera",
      "components": {
        "Camera2DComponent": { "pixels_per_meter": 48 },
        "LocalTransform": { "position": [0, 2, 0] }
      }
    },
    {
      "name": "Ground",
      "components": {
        "Collider2D": { "shape": { "half": [10, 0.5] }, "density": 0 },
        "LocalTransform": { "position": [0, -3, 0] },
        "RigidBody2D": {},
        "Sprite": { "texture": "guid:@GUID_TEX_GROUND@", "size": [20, 1] }
      }
    },
    {
      "name": "Spinner",
      "components": {
        "LocalTransform": { "position": [-3, 1.5, 0] },
        "Sprite": { "texture": "guid:@GUID_TEX_BLOCK@", "size": [1.5, 1.5] },
        "Spin": { "degrees_per_second": 120 }
      }
    },
    {
      "name": "Bobber",
      "components": {
        "LocalTransform": { "position": [3, 1.5, 0] },
        "Sprite": { "texture": "guid:@GUID_TEX_BLOCK@", "size": [1.2, 1.2] },
        "Bob": { "height": 0.75, "period": 2.5 }
      }
    },
    {
      "name": "Crate",
      "components": {
        "Collider2D": {},
        "LocalTransform": { "position": [0, 5, 0] },
        "RigidBody2D": { "type": "Dynamic" },
        "Sprite": { "texture": "guid:@GUID_TEX_BLOCK@" }
      }
    },
    {
      "name": "Title",
      "components": {
        "LocalTransform": { "position": [0, 5, 0] },
        "TextLabel": { "font": "guid:@GUID_FONT@", "text": "@TITLE@", "color": [1, 0.95, 0.8, 1], "height": 0.6 }
      }
    },
    {
      "name": "Options",
      "components": {
        "UiFlow": { "show_on": "Pause", "hide_on": "Back", "pause": true },
        "UiScreen": { "document": "guid:@GUID_UI_OPTIONS@", "order": 10, "visible": false }
      }
    }
  ]
}
