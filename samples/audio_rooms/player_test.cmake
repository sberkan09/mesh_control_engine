# audio_rooms headless contract (cmake -P): the walk plays with no error, the offline render of
# the mix is the same on two runs, and it is neither silent nor past the limiter's ceiling.

function(run_player wav hash_var peak_var)
    execute_process(COMMAND "${MCE_PLAYER}" -headless 1 -ticks 720 -pack "${PACK}" -audio_record "${wav}"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "mce_player exited ${rc}\n${out}\n${err}")
    endif()
    if("${out}${err}" MATCHES "does not load|\\[error\\]")
        message(FATAL_ERROR "the demo logged an error:\n${out}\n${err}")
    endif()
    if(NOT "${out}${err}" MATCHES "audio_record ([0-9]+) frames \\([0-9.]+ s\\), peak ([0-9.]+), hash ([0-9a-f]+)")
        message(FATAL_ERROR "no audio_record line:\n${out}\n${err}")
    endif()
    if(NOT CMAKE_MATCH_1 EQUAL 576000)
        message(FATAL_ERROR "the recording is ${CMAKE_MATCH_1} frames, not 12 s at 48 kHz")
    endif()
    if(NOT EXISTS "${wav}")
        message(FATAL_ERROR "no WAV written at ${wav}")
    endif()
    set(${hash_var} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(${peak_var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

run_player("${WORK_DIR}/run1.wav" first peak)
run_player("${WORK_DIR}/run2.wav" second peak_again)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "two renders of the walk differ: ${first} vs ${second}")
endif()
if(peak LESS 0.05)
    message(FATAL_ERROR "the walk is almost silent (peak ${peak})")
endif()
if(peak GREATER 1.0)
    message(FATAL_ERROR "the mix passes the limiter's ceiling (peak ${peak})")
endif()
message(STATUS "audio_rooms: 12 s rendered, peak ${peak}, hash ${first}")
