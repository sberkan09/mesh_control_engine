{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "MCE_BUILD_TESTS": "ON" }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "msvc-debug",   "displayName": "MSVC Debug",   "inherits": "msvc-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "msvc-release", "displayName": "MSVC Release", "inherits": "msvc-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    {
      "name": "msvc-determinism",
      "displayName": "MSVC Determinism (alias of release, ADR-0007)",
      "inherits": "msvc-release"
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC ASan",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MCE_ASAN": "ON", "MCE_ENABLE_TRACY": "OFF" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "linux-gcc-debug",     "inherits": "linux-base", "cacheVariables": { "CMAKE_CXX_COMPILER": "g++",     "CMAKE_C_COMPILER": "gcc",   "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-gcc-release",   "inherits": "linux-base", "cacheVariables": { "CMAKE_CXX_COMPILER": "g++",     "CMAKE_C_COMPILER": "gcc",   "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    { "name": "linux-clang-debug",   "inherits": "linux-base", "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_C_COMPILER": "clang", "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-clang-release", "inherits": "linux-base", "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_C_COMPILER": "clang", "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    {
      "name": "linux-asan",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_C_COMPILER": "gcc", "CMAKE_BUILD_TYPE": "Debug", "MCE_ASAN": "ON", "MCE_ENABLE_TRACY": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",          "configurePreset": "msvc-debug" },
    { "name": "msvc-release",        "configurePreset": "msvc-release" },
    { "name": "msvc-determinism",    "configurePreset": "msvc-determinism" },
    { "name": "msvc-asan",           "configurePreset": "msvc-asan" },
    { "name": "linux-gcc-debug",     "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release",   "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-debug",   "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-asan",          "configurePreset": "linux-asan" }
  ],
  "testPresets": [
    { "name": "msvc-debug",          "configurePreset": "msvc-debug",          "output": { "outputOnFailure": true } },
    { "name": "msvc-release",        "configurePreset": "msvc-release",        "output": { "outputOnFailure": true } },
    { "name": "msvc-asan",           "configurePreset": "msvc-asan",           "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-debug",     "configurePreset": "linux-gcc-debug",     "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-release",   "configurePreset": "linux-gcc-release",   "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug",   "configurePreset": "linux-clang-debug",   "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "output": { "outputOnFailure": true } },
    { "name": "linux-asan",          "configurePreset": "linux-asan",          "output": { "outputOnFailure": true } }
  ]
}
